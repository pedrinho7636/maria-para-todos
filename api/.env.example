PORT=3001

# Banco hospedado (Neon, Render, etc.): basta a URL de conexão, com SSL.
# Se estiver preenchida, os PG* abaixo são ignorados. Deixe vazia no uso local.
DATABASE_URL=

# Atrás de proxy (hospedagem como o Render), use 1 pra os limites de login
# enxergarem o IP real de cada visitante. Deixe vazio rodando local.
TRUST_PROXY=

# Intervalo (minutos) da conclusão automática dos atendimentos já realizados.
# Padrão 5. Em hospedagem com banco que dorme (Neon grátis), use um valor maior (ex.: 30).
CONCLUSAO_MINUTOS=

# Dados de conexão do PostgreSQL local (ajuste após instalar o Postgres)
PGHOST=localhost
PGPORT=5432
PGDATABASE=portal_da_maria
PGUSER=postgres
PGPASSWORD=troque-esta-senha

# Segredo usado para assinar os tokens JWT — troque por uma string aleatória de
# pelo menos 32 caracteres (ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# A API recusa subir com este valor de exemplo ou com um segredo curto.
JWT_SECRET=troque-este-segredo

# Origens permitidas pelo CORS, separadas por vírgula (default: só o Live
# Server/`npx serve` local). Adicione o domínio de produção aqui quando houver.
CORS_ORIGINS=http://localhost:5000

# Envio de e-mail (códigos de cadastro e de troca de e-mail no perfil).
# Ordem de preferência: SMTP > Resend > modo simulado (só loga no console).
#
# OPÇÃO 1 — SMTP (recomendada pra testes: entrega pra QUALQUER destinatário).
# Com Gmail: ative a verificação em duas etapas na conta e gere uma "senha de
# app" em https://myaccount.google.com/apppasswords (16 letras, sem espaços).
# Valide com: npm run email:teste -- seu@email.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Opcional. Padrão: "Portal da Maria <SMTP_USER>" (o Gmail só aceita o próprio endereço).
SMTP_FROM=
#
# OPÇÃO 2 — Resend (https://resend.com). A conta de teste só entrega pro e-mail
# dono da conta; pra qualquer outro destinatário é preciso verificar um domínio.
RESEND_API_KEY=
# Remetente usado nos e-mails. Sem domínio próprio verificado na Resend, use
# o domínio de testes deles — mas ele só entrega pro e-mail da sua própria
# conta Resend, não pra qualquer destinatário (limitação da conta grátis sem
# domínio verificado).
EMAIL_FROM=Portal da Maria <onboarding@resend.dev>
